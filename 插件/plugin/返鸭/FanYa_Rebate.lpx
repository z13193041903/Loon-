# 引用链接: https://kelee.one/Tool/Loon/Lpx/JD_Price.lpx / WPS_checkin.lpx 结构参考
#!name=返鸭返利比价
#!desc=在淘宝、京东、拼多多商品详情页首图下方展示「返鸭」APP 预估返佣金额，并参考慢慢买展示历史价格趋势、判断是否涨价。首次使用需在插件参数中填写返鸭 API 地址与 Token（佣金数据来源为你的返鸭服务端）。
#!openUrl=
#!author=FanYa
#!tag=功能增强
#!system=
#!system_version=
#!loon_version=3.2.4(787)
#!homepage=https://hub.kelee.one
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!date=2026-10-29 00:45:00

[Argument]
FANYA_API=input, "", tag=返鸭API地址, desc=你的返鸭服务端地址，例如 https://api.fanya.example.com。留空则仅显示价格趋势。
FANYA_TOKEN=input, "", tag=返鸭Token, desc=调用返鸭佣金接口所需的访问令牌（在返鸭APP个人中心获取）。
SHOW_COMMISSION=switch, true, true, tag=显示返佣金额, desc=是否在商品详情页展示返鸭预估返佣。
SHOW_TREND=switch, true, true, tag=显示价格趋势, desc=是否展示慢慢买历史价格趋势与涨价判断。

[Script]
# ===== App 内页面（JSON 注入，首图下方楼层位置） =====
http-response ^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=wareBusiness script-path=FANYA_JS_URL, requires-body=true, timeout=20, tag=京东商品返佣比价, argument=[{FANYA_API}|{FANYA_TOKEN}|{SHOW_COMMISSION}|{SHOW_TREND}]

http-response ^https?:\/\/trade-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.detail\.getdetail script-path=FANYA_JS_URL, requires-body=true, timeout=20, tag=淘宝商品返佣比价, argument=[{FANYA_API}|{FANYA_TOKEN}|{SHOW_COMMISSION}|{SHOW_TREND}]

http-response ^https?:\/\/mobile\.yangkeduo\.com\/proxy\/api\/api\/oak\/integration\/render script-path=FANYA_JS_URL, requires-body=true, timeout=20, tag=拼多多商品返佣比价, argument=[{FANYA_API}|{FANYA_TOKEN}|{SHOW_COMMISSION}|{SHOW_TREND}]

# ===== H5 网页版（HTML 注入，降级方案） =====
http-response ^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html script-path=FANYA_JS_URL, requires-body=true, timeout=20, tag=京东网页返佣比价, argument=[{FANYA_API}|{FANYA_TOKEN}|{SHOW_COMMISSION}|{SHOW_TREND}]

http-response ^https?:\/\/(item|detail\.m)\.(taobao|tmall)\.com\/(item|item_detail)\.htm script-path=FANYA_JS_URL, requires-body=true, timeout=20, tag=淘宝网页返佣比价, argument=[{FANYA_API}|{FANYA_TOKEN}|{SHOW_COMMISSION}|{SHOW_TREND}]

http-response ^https?:\/\/mobile\.yangkeduo\.com\/goods\.html script-path=FANYA_JS_URL, requires-body=true, timeout=20, tag=拼多多网页返佣比价, argument=[{FANYA_API}|{FANYA_TOKEN}|{SHOW_COMMISSION}|{SHOW_TREND}]

[MitM]
hostname=api.m.jd.com, in.m.jd.com, trade-acs.m.taobao.com, mobile.yangkeduo.com, item.taobao.com, detail.m.tmall.com
