#!name = 上汽荣威自动签到
#!desc = 🚗 多账号自动看视频签到，+15积分/天。首次使用：打开「捕获Token」开关 → 荣威App进一次签到页 → 收到通知后关闭
#!author = KEMO
#!homepage = https://github.com/z13193041903/Loon-/tree/main/插件/plugin/上汽荣威签到
#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Car.png
#!tag = 签到,积分
#!date = 2026-10-28
#!type = normal
#!loon_version = 3.5.1(983)

[Argument]
capture = switch,false,type=boolean,tag=捕获Token,desc=打开后到荣威App进一次签到页，收到通知后关闭
notify = switch,true,type=boolean,tag=结果通知,desc=签到完成后是否推送通知
maxtimes = input,3,type=number,tag=每日签到次数,desc=看视频签到每日上限3次
delay = input,2,type=number,tag=签到间隔秒数,desc=每次签到之间的间隔
accounts = input,"",type=string,tag=多账号列表,desc=格式 token1#userid1@token2#userid2，单人留空即可
debug = switch,false,type=boolean,tag=调试日志,desc=排查问题时打开
cron = input,"0 8 * * *",type=string,tag=定时表达式,desc=符合CRON格式，默认每天8点

[Script]
http-request (?i)https?:\/\/social\.roewe\.com\.cn\/api\/energy\/task script-path=https://raw.githubusercontent.com/z13193041903/Loon-/main/插件/plugin/上汽荣威签到/roewe_capture.js, tag=荣威Token捕获, enable={capture}
cron ({cron}) script-path=https://raw.githubusercontent.com/z13193041903/Loon-/main/插件/plugin/上汽荣威签到/roewe_checkin.js, tag=上汽荣威签到, argument=notify={notify}&maxtimes={maxtimes}&delay={delay}&accounts={accounts}&debug={debug}, enable=true

[Mitm]
hostname = social.roewe.com.cn
